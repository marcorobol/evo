# URL dell'istanza Deliveroo.js in esecuzione
DELIVEROO_URL=http://localhost:8080

# Alternativa al nome per l'autenticazione verso Deliveroo.js
# DELIVEROO_TOKEN=
DELIVEROO_NAME=evolving-agent

# Provider del generatore di capability. Per LM Studio non serve una chiave.
LLM_PROVIDER=lmstudio
LLM_MODEL=
LLM_BASE_URL=http://localhost:1234/v1
# Necessaria soltanto se in LM Studio abiliti “Require Authentication”.
# LMSTUDIO_API_KEY=

# Azure OpenAI e Vertex AI saranno aggiunti come provider sperimentali separati.

# Goal per la prima generazione sperimentale.
CAPABILITY_GOAL=Deliver a visible parcel while respecting the known environment constraints.

# Numero massimo di revisioni LLM dopo una capability non valida.
MAX_REPAIR_ATTEMPTS=2
