# Copy this file to .env. It is loaded by the runnable scripts and must never
# be committed because it contains OPENAI_API_KEY.

# UniTn LiteLLM gateway (OpenAI-compatible /v1/chat/completions API).
# OPENAI_* is authoritative when OPENAI_BASE_URL is set.
OPENAI_BASE_URL=https://llm.bears.disi.unitn.it
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.8-27b

# Optional live Deliveroo.js connection. LIVE_ACTION_INTERVAL_MS drives both
# start:deliveroo and play:live:evolving.
DELIVEROO_URL=http://localhost:8080
DELIVEROO_NAME=evolving-agent
# DELIVEROO_TOKEN=
LIVE_ACTION_INTERVAL_MS=350

# Direct capability-artifact evolution. The model defaults to OPENAI_MODEL.
# CAPABILITY_ARTIFACT_MODEL=qwen3.8-27b
# CAPABILITY_ARTIFACT_RUN_ID=artifact-evolve-<timestamp>

# Blank-slate regime: the engineered substrate defers every decision and the
# artifact prompt carries no game hints, so benchmark score comes only from
# evolved capabilities. Do not mix regimes on one promoted store: reset
# agent-workspace/discovered-capabilities/ when switching.
EVOLUTION_BLANK_SLATE=0

# Full TypeScript module-patch evolution. MODULE_PATCH_MODELS is a comma-
# separated list of LiteLLM model IDs, used in order across attempts.
MODULE_PATCH_ATTEMPTS=2
MODULE_PATCH_MODELS=llama-3.3-70b,qwen3.8-27b
EVOLUTION_FROM_SCRATCH=0
# MODULE_PATCH_RUN_ID=module-evolve-<timestamp>

# Autonomous challenge discovery. CHALLENGE_MODELS is comma-separated.
CHALLENGE_ATTEMPTS=2
CHALLENGE_MODELS=llama-3.3-70b,qwen3.8-27b
# CHALLENGE_RUN_ID=challenge-discovery-<timestamp>

# Per-decision sandbox timeout (ms) for generated capability code.
# CANDIDATE_DECISION_TIMEOUT_MS=100

# The promoted capability store (agent-workspace/discovered-capabilities/) and
# the legacy promotion history (agent-workspace/promoted/) are gitignored: they
# are experiment state, not code. Locally, `bun run
# src/migrate-promoted-policies.ts` rebuilds the store from that history after a
# from-scratch reset; a fresh clone starts from the pure substrate baseline.
