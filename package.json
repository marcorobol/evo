{
  "name": "evolving-deliveroo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "evo": "./bin/evo"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cli": "bun run src/evo-cli.ts",
